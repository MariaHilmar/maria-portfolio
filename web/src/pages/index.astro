---
import BaseLayout from "../layouts/BaseLayout.astro";

const cvFile = "MariaHilmar_Curriculo_ATS.pdf";
const cvHref = `/${cvFile}`;

const capabilities = [
  "Produto e requisitos",
  "APIs e dados",
  "Apps e BI",
  "Segurança e LGPD",
  "IA aplicada",
  "Qualidade",
];

const proofPoints = [
  {
    label: "JurisSync",
    detail: "43 testes · 5 camadas · ~90% cobertura",
    href: "https://github.com/MariaHilmar/juris-sync",
  },
  {
    label: "PayCore",
    detail: "Ledger double-entry · 33 testes",
    href: "https://github.com/MariaHilmar/paycore",
  },
  {
    label: "MGI Kpi",
    detail: "Demo live · 358 testes Vitest",
    href: "https://web-mgi-delog.vercel.app",
  },
  {
    label: "Como avaliar",
    detail: "Competências com evidências",
    href: "/docs/competencias",
  },
];
---

<BaseLayout
  description="Lead Tech PM | Product Manager / Engineer (Dados & IA): liderança de produto e engenharia com gestão de squads ágeis e atuação hands-on em Python e FastAPI."
>
  <header class="site-header">
    <div class="nav wrap">
      <a class="brand" href="#topo">Maria Hilmar</a>
      <nav aria-label="Principal">
        <a href="#prova">Prova técnica</a>
        <a href="#sobre">Sobre</a>
        <a href="#produto">Produto</a>
        <a href="#projetos">Projetos</a>
        <a href="#contato">Contato</a>
        <a class="nav-cv" href={cvHref} download={cvFile}>Currículo PDF</a>
      </nav>
    </div>
  </header>

  <div class="hero-band">
    <main id="topo">
      <section class="hero wrap">
        <div class="hero-content">
          <p class="hero-kicker">Lead Tech PM · Dados &amp; IA</p>
          <h1 class="hero-name">Maria Hilmar</h1>
          <p class="hero-role">Lead Tech PM | Product Manager / Engineer (Dados &amp; IA)</p>
          <p class="hero-tagline">
            Liderança de produto com atuação hands-on em Python e FastAPI. Transformo regras
            densas em arquiteturas SaaS, pipelines de dados e produtos orientados a ROI - com
            evidências públicas no GitHub.
          </p>
          <div class="hero-cta">
            <a class="btn btn-hero" href="#prova">Ver evidências públicas</a>
            <a class="btn btn-ghost hero-ghost" href={cvHref} download={cvFile}
              >Baixar Currículo (PDF)</a
            >
          </div>
        </div>
      </section>
    </main>
  </div>

  <main>
    <section id="prova" class="proof-band reveal">
      <div class="wrap">
        <span class="section-label">Prova técnica</span>
        <h2>Código, testes e demos para auditoria rápida</h2>
        <p class="section-lead">
          Recortes públicos (clone &amp; run) no mesmo domínio do produto próprio. Comece pelo
          repositório ou pela demo live.
        </p>
        <ul class="proof-grid">
          {
            proofPoints.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="proof-label">{item.label}</span>
                  <span class="proof-detail">{item.detail}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="proof-cta">
          <a class="btn btn-primary" href="https://github.com/MariaHilmar">GitHub</a>
          <a class="btn btn-ghost" href="#projetos">Ver projetos</a>
          <a class="btn btn-ghost" href="/docs/competencias">Competências com evidências</a>
        </div>
      </div>
    </section>

    <section id="sobre" class="section wrap reveal">
      <span class="section-label">Sobre</span>
      <h2>Produto, arquitetura e entrega hands-on</h2>
      <p class="section-lead">
        Reduzo a distância entre estratégia e engenharia: roadmap, requisitos rastreáveis e
        implementação em Python/FastAPI. Histórico em SaaS B2B (DFimoveis), govtech (Qintess) e
        produto próprio de jurimetria - com squads ágeis, OKRs e qualidade (CTAL-TM).
      </p>
      <ul class="about-metrics">
        <li>
          <span class="about-metric-value">95%</span>
          <span class="about-metric-label">entrega com OKRs (DFimoveis)</span>
        </li>
        <li>
          <span class="about-metric-value">90%+</span>
          <span class="about-metric-label">retenção de talentos em squads</span>
        </li>
        <li>
          <span class="about-metric-value">6</span>
          <span class="about-metric-label">produtos SaaS do zero ao Go-live</span>
        </li>
        <li>
          <span class="about-metric-value">Hands-on</span>
          <span class="about-metric-label">Python · FastAPI · dados · IA</span>
        </li>
      </ul>
      <div class="about-grid">
        <div class="about-card">
          <h3>Engenharia, Dados &amp; IA</h3>
          <p>
            <strong>Hands-on:</strong> APIs e serviços com Python e FastAPI, PostgreSQL, Redis,
            Docker e CI/CD.
          </p>
          <p>
            <strong>Dados e IA:</strong> pipelines ETL, SQL, fundamentos de ML (XGBoost), NLP,
            pgvector e estratégias LLM/RAG.
          </p>
          <p>
            <strong>Qualidade:</strong> BDD, testes em camadas, contratos OpenAPI e governança
            CTAL-TM.
          </p>
        </div>
        <div class="about-card">
          <h3>Produto &amp; Arquitetura SaaS</h3>
          <p>
            <strong>Discovery ao Go-live:</strong> roadmap, priorização por valor (ROI) e OKRs
            com alinhamento a stakeholders e engenharia.
          </p>
          <p>
            <strong>Arquitetura:</strong> multi-tenant, RLS, Privacy by Design / LGPD, C4 Model,
            BPMN e UML.
          </p>
          <p>
            <strong>Requisitos:</strong> User Stories em BDD/Gherkin e rastreabilidade até teste.
          </p>
        </div>
        <div class="about-card">
          <h3>Liderança de squads</h3>
          <p>
            <strong>Delivery:</strong> Scrum/Kanban, Capacity Planning, Velocity e Lead Time.
          </p>
          <p>
            <strong>Pessoas:</strong> 1:1s, feedback e ambiente colaborativo, com retenção acima
            de 90% no ciclo DFimoveis.
          </p>
          <p>
            <strong>Negócio:</strong> tradução de métricas técnicas para linguagem executiva.
          </p>
        </div>
      </div>
    </section>

    <section id="produto" class="band-dark section reveal">
      <div class="wrap">
        <span class="section-label on-dark">Produto próprio · código privado</span>
        <h2>Situação Jurídica</h2>
        <p class="section-lead on-dark">
          Ecossistema de jurimetria e dados jurídicos de alta performance desenvolvido como
          iniciativa proprietária (Código e operação privados). Abaixo, a engenharia de produto
          e os impactos arquiteturais demonstrados no sistema:
        </p>

        <div class="sj-layout">
          <div class="sj-copy">
            <div class="sj-block">
              <h3>Problema</h3>
              <p>
                Dados processuais fragmentados. É preciso ingestão, normalização, APIs,
                analytics e conformidade (LGPD) para apoiar decisões de negócio.
              </p>
            </div>
            <div class="sj-block">
              <h3>Papel</h3>
              <p>
                <strong>Product Lead &amp; Architect:</strong> Concepção de roadmap estratégico,
                engenharia de requisitos com BDD, alinhamento de infraestrutura SaaS multi-tenant
                e governança de qualidade de dados.
              </p>
            </div>
            <div class="sj-block">
              <h3>Resultados no ambiente do projeto</h3>
              <ul>
                <li>~60% menos latência após segregação staging/ETL versus serving</li>
                <li>~70% menos esforço de especificação com docs e BDD assistidos por IA</li>
                <li>Isolamento multi-tenant (RLS) e Privacy by Design / LGPD</li>
              </ul>
            </div>
            <div class="project-links">
              <a class="btn btn-primary" href="/docs/case-study-situacao-juridica">Case completo</a>
              <a class="btn btn-ghost on-dark-btn" href="/docs/competencias">Competências</a>
            </div>
          </div>
        </div>

        <p class="caps-label">Capacidades demonstradas no produto</p>
        <ul class="caps-row">
          {capabilities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="projetos" class="section wrap reveal">
      <span class="section-label">Evidências públicas</span>
      <h2>Projetos com código aberto</h2>
      <p class="section-lead">
        Recortes arquiteturais para avaliação técnica e execução local (Clone &amp; Run).
        Demonstrações independentes com foco em padrões de engenharia, concorrência e testes
        automatizados.
      </p>

      <div class="projects-grid">
        <article class="project-card">
          <p class="evidence-kicker">Portfólio público • fintech</p>
          <h3>PayCore</h3>
          <p>
            Motor de pagamentos distribuído estruturado com ledger de partidas dobradas,
            transferências P2P e concorrência financeira. Projetado sob abordagem de especificação
            assistida por IA (SDD).
          </p>
          <ul>
            <li>
              <strong>Double-entry Ledger:</strong> Arquitetura de soma-zero com conta de
              liquidação (settlement) para consistência contábil absoluta.
            </li>
            <li>
              <strong>Concorrência e Escala:</strong> Implementação de SELECT FOR UPDATE para
              mitigação de condições de corrida. Cobertura de ~88% em 33 testes integrados.
            </li>
            <li>
              <strong>Documentação Executiva:</strong> Modelagem visual em C4 Model, dicionário de
              dados relacional ACID e requisitos de segurança.
            </li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="https://github.com/MariaHilmar/paycore" target="_blank" rel="noreferrer"
              >Repositório</a
            >
            <a class="btn btn-ghost" href="/docs/case-study-paycore">Case study</a>
          </div>
        </article>

        <article class="project-card">
          <p class="evidence-kicker">Portfólio público • domínio jurídico</p>
          <h3>JurisSync</h3>
          <p>
            API robusta em FastAPI integrada a dashboard analítico Next.js para sincronização
            idempotente de dados processuais (DataJud CNJ). Foco em resiliência de pipelines e
            esteiras de automação de testes.
          </p>
          <ul>
            <li>
              <strong>Pipeline de Ingestão:</strong> Fluxo otimizado de validação de esquemas e
              persistência de dados em alta vazão.
            </li>
            <li>
              <strong>Resiliência &amp; QA:</strong> Estratégia de testes em 5 camadas com ~90% de
              cobertura utilizando Testcontainers e Schemathesis.
            </li>
            <li>
              <strong>Evidências:</strong> Case study de produto e pipelines de CI/CD públicos para
              auditoria técnica.
            </li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="https://github.com/MariaHilmar/juris-sync" target="_blank" rel="noreferrer"
              >API</a
            >
            <a class="btn btn-ghost" href="https://github.com/MariaHilmar/juris-sync-web" target="_blank" rel="noreferrer"
              >Dashboard</a
            >
            <a class="btn btn-ghost" href="/docs/case-study-juris-sync">Case study</a>
          </div>
        </article>

        <article class="project-card">
          <p class="evidence-kicker">Portfólio público • BI de engenharia</p>
          <h3>MGI Kpi</h3>
          <p>
            Pipeline de ETL escalável em Python integrado a dashboard analítico em Next.js para
            governança de métricas de engenharia. Projeto isolado para simulação de cargas de
            dados reais.
          </p>
          <ul>
            <li>
              <strong>Persistência Avançada:</strong> Operações de Upsert idempotentes e chamadas
              de procedimentos remotos (RPCs) nativos no PostgreSQL.
            </li>
            <li>
              <strong>Qualidade de Código:</strong> 358 testes automatizados via Vitest e análise
              estática de segurança integrada com SonarCloud.
            </li>
            <li>
              <strong>Demo Live:</strong> Interface funcional com autenticação integrada para
              validação da experiência do usuário final.
            </li>
          </ul>
          <div class="project-links">
            <a class="btn btn-primary" href="https://web-mgi-delog.vercel.app" target="_blank" rel="noreferrer"
              >Demo live</a
            >
            <a class="btn btn-ghost" href="https://github.com/MariaHilmar/mgi-kpi-dashboard" target="_blank" rel="noreferrer"
              >Dashboard</a
            >
            <a class="btn btn-ghost" href="https://github.com/MariaHilmar/mgi-kpi-pipeline" target="_blank" rel="noreferrer"
              >Pipeline</a
            >
            <a class="btn btn-ghost" href="/docs/case-study-mgi-kpi">Case study</a>
          </div>
        </article>
      </div>
    </section>

    <section id="contato" class="section wrap reveal">
      <span class="section-label">Contato</span>
      <h2>Vamos conversar</h2>
      <p class="section-lead">
        Busco desafios de Lead Tech PM / Product Engineer (Dados &amp; IA), remoto - da
        concepção à entrega técnica hands-on. Prefiro contato pelo LinkedIn; o GitHub e o
        currículo fecham a avaliação técnica.
      </p>
      <div class="contact-row">
        <a
          class="btn btn-primary"
          href="https://www.linkedin.com/in/mariahilmar/"
          target="_blank"
          rel="noreferrer">Falar no LinkedIn</a
        >
        <a class="btn btn-ghost" href="https://github.com/MariaHilmar" target="_blank" rel="noreferrer"
          >GitHub</a
        >
        <a class="btn btn-ghost" href={cvHref} download={cvFile}>Currículo PDF</a>
        <a class="btn btn-ghost" href="mailto:mariahilmar@gmail.com">E-mail</a>
      </div>
    </section>
  </main>

  <footer class="footer wrap">
    <p>
      Maria Hilmar ·
      <a href="https://mariahilmar.vercel.app">Live</a>
      · Lead Tech PM · Dados &amp; IA
    </p>
  </footer>
</BaseLayout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 28, 34, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(213, 232, 233, 0.12);
  }

  .hero-band {
    background:
      radial-gradient(700px 480px at 78% 18%, rgba(45, 154, 158, 0.24), transparent 58%),
      radial-gradient(520px 360px at 8% 72%, rgba(45, 154, 158, 0.14), transparent 55%),
      linear-gradient(180deg, #0c1c22 0%, #123038 62%, #1a3a42 100%);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: #f7fafb;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
  }

  .nav a {
    color: rgba(247, 250, 251, 0.82);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: #9ed0d2;
  }

  .nav-cv {
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(247, 250, 251, 0.55);
    border-radius: 999px;
    color: #f7fafb;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .nav-cv:hover {
    color: #f7fafb;
    background: rgba(247, 250, 251, 0.1);
    border-color: rgba(247, 250, 251, 0.85);
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: center;
    padding: clamp(2.8rem, 7vw, 5rem) 0 clamp(3.2rem, 8vw, 5.5rem);
  }

  .hero-content {
    min-width: 0;
    max-width: 40rem;
    animation: rise 0.9s ease both;
  }

  .btn-hero {
    background: #f7fafb;
    color: var(--ink);
  }

  .btn-hero:hover {
    background: #d5e8e9;
    color: var(--ink);
  }

  .hero-kicker {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9ed0d2;
    margin: 0 0 1rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 0.65rem;
    color: #f7fafb;
  }

  .hero-role {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #d5e8e9;
    margin: 0 0 1.1rem;
  }

  .hero-tagline {
    max-width: 36rem;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.65;
    color: rgba(247, 250, 251, 0.78);
    margin: 0 0 1.75rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-cta .btn {
    flex: 0 1 auto;
  }

  .hero-ghost {
    border-color: rgba(247, 250, 251, 0.65);
    color: #f7fafb;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .hero-ghost:hover {
    background: rgba(247, 250, 251, 0.1);
    color: #f7fafb;
    border-color: rgba(247, 250, 251, 0.85);
  }

  .proof-band {
    padding: clamp(2.5rem, 5vw, 3.75rem) 0;
    background: rgba(255, 255, 255, 0.55);
    border-bottom: 1px solid var(--line);
  }

  .proof-band h2 {
    margin: 0.35rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .proof-grid {
    list-style: none;
    margin: 1.5rem 0 1.25rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .proof-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem 1.05rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .proof-grid a:hover {
    border-color: rgba(26, 107, 110, 0.35);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
    color: inherit;
  }

  .proof-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--teal-deep);
  }

  .proof-detail {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .proof-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about-metrics {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .about-metrics li {
    padding: 0.9rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
  }

  .about-metric-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: -0.02em;
  }

  .about-metric-label {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  #sobre .section-lead {
    max-width: 52rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .about-card {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .about-card h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .about-card p {
    margin: 0;
    color: var(--ink-soft);
  }

  .about-card p + p {
    margin-top: 0.75rem;
  }

  .band-dark {
    background:
      radial-gradient(800px 400px at 90% 10%, rgba(26, 107, 110, 0.35), transparent 55%),
      linear-gradient(180deg, #132028 0%, #1a2f36 100%);
    color: #f7fafb;
  }

  .band-dark h2,
  .band-dark h3 {
    color: #f7fafb;
  }

  .section-label.on-dark,
  .caps-label {
    color: #9ed0d2;
  }

  .section-lead.on-dark {
    color: rgba(247, 250, 251, 0.78);
  }

  .sj-layout {
    margin-bottom: 2.5rem;
  }

  .sj-copy {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem 2rem;
    align-items: start;
  }

  .sj-copy .project-links {
    grid-column: 1 / -1;
  }

  .sj-block h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
  }

  .sj-block p,
  .sj-block li {
    color: rgba(247, 250, 251, 0.78);
    margin: 0;
  }

  .sj-block ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .sj-block li + li {
    margin-top: 0.35rem;
  }

  .caps-label {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.85rem;
  }

  .caps-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

